                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvAuthVisa"
                    app:layout_constraintWidth_percent="0.5" />

                <TextView
                    android:id="@+id/tvSaleCol1Visa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00"
                    app:layout_constraintEnd_toStartOf="@+id/tvSaleCol2Visa"
                    app:layout_constraintStart_toEndOf="@id/tvSaleVisa"
