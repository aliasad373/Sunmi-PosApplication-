                    app:layout_constraintTop_toBottomOf="@id/tvSaleUPI"
                    app:layout_constraintWidth_percent="0.5" />

                <TextView
                    android:id="@+id/tvVoidCol1UPI"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00"
                    app:layout_constraintEnd_toStartOf="@+id/tvVoidCol2UPI"
                    app:layout_constraintStart_toEndOf="@id/tvVoidUPI"
                    app:layout_constraintTop_toBottomOf="@id/tvSaleCol1UPI"
                    app:layout_constraintWidth_percent="0.25" />

                <TextView
                    android:id="@+id/tvVoidCol2UPI"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvVoidCol1UPI"
                    app:layout_constraintTop_toBottomOf="@id/tvSaleCol2UPI"
                    app:layout_constraintWidth_percent="0.25" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:background="@color/black"
                app:layout_constraintTop_toBottomOf="@+id/containerUpi" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayout32"
            app:layout_constraintVertical_bias="0.0">

            <TextView
                android:id="@+id/tv_header_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Grand Total: "
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_header_total">

                <!-- ===== Row 1 ===== -->
                <TextView
                    android:id="@+id/tvAuthTotal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Sales"
                    android:textSize="16sp"

                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.5" />



                <TextView
                    android:id="@+id/tvAuthCol2Total"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.25" />

                <!-- ===== Row 2 ===== -->
                <TextView
                    android:id="@+id/tvSaleTotal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Void"
                    android:textSize="16sp"

                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvAuthTotal"
                    app:layout_constraintWidth_percent="0.5" />



                <TextView
                    android:id="@+id/tvSaleCol2Total"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvAuthCol2Total"
                    app:layout_constraintWidth_percent="0.25" />

                <!-- ===== Row 3 ===== -->
                <TextView
                    android:id="@+id/tvVoidTotal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Total Amount"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSaleTotal"
                    app:layout_constraintWidth_percent="0.5" />



                <TextView
                    android:id="@+id/tvVoidCol2Total"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSaleCol2Total"
                    app:layout_constraintWidth_percent="0.25" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:background="@color/black"
                app:layout_constraintTop_toBottomOf="@+id/containerTotal" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
