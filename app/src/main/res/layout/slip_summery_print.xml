                    app:layout_constraintEnd_toStartOf="@+id/tvSaleCol1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvAuth"
                    app:layout_constraintWidth_percent="0.5" />

                <TextView
