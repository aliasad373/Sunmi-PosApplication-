                <TextView
                    android:id="@+id/tvVoidCol1pay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00"
                    app:layout_constraintEnd_toStartOf="@+id/tvVoidCol2Pay"
