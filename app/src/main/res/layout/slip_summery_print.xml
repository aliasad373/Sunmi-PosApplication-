                <TextView
                    android:id="@+id/tvVoidCol1Visa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00"
                    app:layout_constraintEnd_toStartOf="@+id/tvVoidCol2Visa"
                    app:layout_constraintStart_toEndOf="@id/tvVoidVisa"
