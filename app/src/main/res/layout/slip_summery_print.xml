                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00"
                    app:layout_constraintEnd_toStartOf="@+id/tvSaleCol2"
                    app:layout_constraintStart_toEndOf="@id/tvSale"
