<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#FFFFFF" /> <!-- Replace with your color -->

    <!-- Rounded corners -->
    <corners android:radius="16dp" /> <!-- Adjust radius -->

    <!-- Stroke (border) -->
